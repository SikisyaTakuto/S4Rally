# まずすべてを無視
*

# .gitignore 自体は無視しない
!.gitignore

# cpp と h ファイルは追跡対象とする
!*.cpp
!*.h

# フォルダ構成維持のためにディレクトリは許可（中身は引き続き無視）
!*/

# Visual Studio関連ファイルを明示的に無視（保険として）
.vscode/
*.suo
*.ncb
*.sdf
*.pdb
*.aps
*.cache
*.ilk
*.ipch
*.obj
*.tlog
*.log
*.user
*.filters
*.VC.db
*.opendb
*.VC.VC.opendb
*.db-shm
*.db-wal

# ビルド出力関連
*.exe
*.dll
*.lib
*.exp
*.iobj
*.ipdb
*.idb
*.pch
*.res
*.map

# ビルドフォルダ
Debug/
Release/
x64/Debug/
x64/Release/
Win32/Debug/
Win32/Release/

# CMake関連（必要なら追加）
CMakeLists.txt.user
CMakeCache.txt
CMakeFiles/
cmake_install.cmake

# DxLib関連の不要なファイル
DxLib.lib
DxLib.x86.lib
DxLib.x64.lib
DxGraphics.lib
DxGraphicsX.lib
DxUseCLib.lib
DxShaderBin.lib
DxShaderCode.lib

DxLib_VC/
DxLib_VC/Debug/
DxLib_VC/Release/
DxLib_VC/*.lib
DxLib_VC/*.dll
DxLib_VC/*.exe
DxLib_VC/*.obj

DxLibSourceTest_WithUseCLib/
DxLibSourceTest_WithUseCLib/Debug/
DxLibSourceTest_WithUseCLib/Release/
DxLibSourceTest_WithUseCLib/*.lib
DxLibSourceTest_WithUseCLib/*.dll
DxLibSourceTest_WithUseCLib/*.exe
DxLibSourceTest_WithUseCLib/*.obj

# FBX SDK関連の不要ファイル
FBXSDK/
FBXSDK/lib/
FBXSDK/include/
FBXSDK/bin/
FBXSDK/Debug/
FBXSDK/Release/
FBXSDK/*.lib
FBXSDK/*.dll
FBXSDK/*.pdb
FBXSDK/*.exp
FBXSDK/*.exe
FBXSDK/*.obj

# 音楽・フォントファイル
*.mp3
*.ttf

# その他
Thumbs.db
*.bak
*.tmp