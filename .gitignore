# ---------------------
# すべてのファイルを無視
# ---------------------
*

# ---------------------
# 必要なファイル・フォルダを例外として指定
# ---------------------

# .gitignore ファイル自体は無視しない
!.gitignore

# C++ ヘッダおよびソースファイルは追跡対象
!*.cpp
!*.h

# フォルダ構造は追跡（中身のファイルは上記の例外指定が必要）
!*/

# ---------------------
# Visual Studio 関連ファイルの明示的な除外
# ---------------------
*.sln
*.vcxproj
*.vcxproj.filters
*.vcxproj.user
*.suo
*.ncb
*.sdf
*.pdb
*.aps
*.cache
*.ilk
*.ipch
*.obj
*.tlog
*.log
*.user
*.VC.db
*.opendb
*.VC.VC.opendb
*.db-shm
*.db-wal

# ---------------------
# ビルド出力・一時ファイル
# ---------------------
*.exe
*.dll
*.lib
*.exp
*.iobj
*.ipdb
*.idb
*.pch
*.res
*.map

# ---------------------
# ビルドフォルダ
# ---------------------
Debug/
Release/
x64/Debug/
x64/Release/
Win32/Debug/
Win32/Release/

# ---------------------
# CMake 関連（使用している場合）
# ---------------------
CMakeLists.txt.user
CMakeCache.txt
CMakeFiles/
cmake_install.cmake

# ---------------------
# DxLib 関連の一時ファイル・ビルド出力
# ---------------------
DxLib*.lib
DxGraphics*.lib
DxUseCLib.lib
DxShaderBin.lib
DxShaderCode.lib

DxLib_VC/
DxLib_VC/**/*.lib
DxLib_VC/**/*.dll
DxLib_VC/**/*.exe
DxLib_VC/**/*.obj
DxLib_VC/**/Debug/
DxLib_VC/**/Release/

DxLibSourceTest_WithUseCLib/
DxLibSourceTest_WithUseCLib/**/*.lib
DxLibSourceTest_WithUseCLib/**/*.dll
DxLibSourceTest_WithUseCLib/**/*.exe
DxLibSourceTest_WithUseCLib/**/*.obj
DxLibSourceTest_WithUseCLib/**/Debug/
DxLibSourceTest_WithUseCLib/**/Release/

# ---------------------
# FBX SDK 関連
# ---------------------
FBXSDK/
FBXSDK/**/lib/
FBXSDK/**/include/
FBXSDK/**/bin/
FBXSDK/**/Debug/
FBXSDK/**/Release/
FBXSDK/**/*.lib
FBXSDK/**/*.dll
FBXSDK/**/*.pdb
FBXSDK/**/*.exp
FBXSDK/**/*.exe
FBXSDK/**/*.obj

# ---------------------
# その他の不要ファイル
# ---------------------
*.mp3
*.ttf
Thumbs.db
*.bak
*.tmp